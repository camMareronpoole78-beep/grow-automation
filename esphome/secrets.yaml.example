# Copy this file to secrets.yaml in the SAME folder as the node .yaml files
# before compiling/flashing. secrets.yaml is listed in .gitignore. NEVER commit
# or share it: it's the only file with real credentials in it.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot password if a node ever loses wifi (must be 8+ chars).
# CHANGE THIS.
fallback_password: "changeme123"

# Random 32-byte base64 key per node — generate one at
# https://esphome.io/components/api.html#configuration-variables
# or run: esphome secrets — the ESPHome dashboard will generate one for you
# on first "Encryption key" prompt if you leave this blank initially.
api_encryption_key: "REPLACE_WITH_GENERATED_KEY"

# Protects over-the-air updates. CHANGE THIS.
ota_password: "changeme123"
